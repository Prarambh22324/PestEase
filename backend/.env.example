# ── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pestease
DB_USER=postgres
DB_PASS=your_password_here

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES=7d

# ── Rover Auth ───────────────────────────────────────
ROVER_API_KEY=rover_secret_key_change_this

# ── AI Inference ─────────────────────────────────────
# "http"       → calls a Python FastAPI microservice (recommended for production)
# "subprocess" → spawns Python directly (good for single RPi deployment)
INFERENCE_MODE=http
INFERENCE_SERVICE_URL=http://localhost:8000/predict

# ── AWS (optional, for image storage) ───────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=pestease-images

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=info
